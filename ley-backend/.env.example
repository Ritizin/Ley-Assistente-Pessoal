# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- TTS (ElevenLabs) ---
# true = pula a ElevenLabs e vai direto pro Piper (evita esperar timeout de
# rede quando você só usa Piper mesmo)
TTS_SKIP_ELEVENLABS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- WhatsApp (Baileys) ---
WHATSAPP_SESSION_DIR=./storage/whatsapp-session

# --- Gmail Multi-Contas ---
# Contas ficam persistidas em SQLite (storage/jarvis.db), não em .env.
# Senha de App do Google exigida (não a senha normal da conta).
GMAIL_ENCRYPTION_KEY=changeme_32_bytes_min_para_aes256

# --- Webhooks ---
WEBHOOK_SECRET=changeme_webhook_shared_secret

# --- Piper (TTS local, grátis, offline — fallback antes do navegador) ---
# Aceita caminho absoluto ou relativo (resolvido a partir da pasta de onde
# o backend é iniciado, normalmente ley-backend/).
# - Local, com ley-tts ao lado de ley-backend (sibling):
#   PIPER_BIN_PATH=../ley-tts/piper/piper/piper
#   PIPER_VOICE_MODEL_PATH=../ley-tts/voices/pt_BR-cadu-medium.onnx
# - Render (scripts/render-build.sh baixa pra vendor/piper a cada deploy):
#   PIPER_BIN_PATH=./vendor/piper/piper/piper
#   PIPER_VOICE_MODEL_PATH=./vendor/piper/voices/pt_BR-cadu-medium.onnx
PIPER_BIN_PATH=
PIPER_VOICE_MODEL_PATH=

# --- Spotify (OAuth) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# --- Instagram (Login do Facebook p/ Contas Profissionais) ---
# Criar em developers.facebook.com -> App -> produto "Instagram"
# A conta do Instagram precisa ser Profissional/Criador e estar vinculada a
# uma Página do Facebook.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3000/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v21.0
# token que você mesmo escolhe e repete na configuração do Webhook no painel Meta
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=changeme_instagram_webhook_token

# --- Google Home (Smart Device Management API — dispositivos Nest) ---
# 1) console.cloud.google.com -> credenciais OAuth 2.0 (Client ID/Secret)
# 2) console.nest.google.com/device-access -> cria o projeto (Device Access,
#    taxa única de US$5) e pega o Project ID
GOOGLE_HOME_CLIENT_ID=
GOOGLE_HOME_CLIENT_SECRET=
GOOGLE_HOME_REDIRECT_URI=http://127.0.0.1:3000/api/google-home/callback
GOOGLE_HOME_PROJECT_ID=

# --- Login com Google (auth do app + Google Agenda) ---
# console.cloud.google.com -> Credenciais -> OAuth Client ID -> Web application
# Precisa ser um Client ID DIFERENTE do Google Home (escopos diferentes: aqui
# é login/identidade + "https://www.googleapis.com/auth/calendar.readonly"
# pra Google Agenda). Em produção (Render), a tela de consentimento OAuth
# precisa estar em modo "Testing" com seu e-mail na lista de "Test users"
# (Google Cloud Console -> OAuth consent screen -> Audience/Test users) —
# senão o login trava com "Acesso bloqueado" / erro 403 access_denied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# local: http://127.0.0.1:3000/auth/google/callback
# Render: https://<url-do-seu-backend>.onrender.com/auth/google/callback
# (cadastre a mesma URL em "Authorized redirect URIs" no Google Cloud Console)
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
# pra onde o navegador volta depois do login, com o token JWT na URL
# local: http://127.0.0.1:5173 | Render: https://<url-do-seu-frontend>.onrender.com
FRONTEND_URL=http://127.0.0.1:5173

# --- Banco de dados de autenticação (usuários logados via Google) ---
# Sem DATABASE_URL, o auth cai automaticamente pra SQLite local
# (storage/auth.db) — ok pra desenvolver sozinho, mas os apps desktop/Android
# rodando em máquinas diferentes precisam de um Postgres compartilhado (ex:
# Railway, Supabase, Render — todos têm plano free).
DATABASE_URL=

# String aleatória forte (ex: `openssl rand -hex 32`) usada pra assinar os
# JWT de sessão. OBRIGATÓRIA quando NODE_ENV=production — o servidor recusa
# subir sem ela. Nunca reutilize um valor de exemplo/tutorial.
JWT_SECRET=
