{
  "name": "ley-api",
  "version": "0.1.0",
  "type": "module",
  "description": "API estilo Ley - Fastify + WS + Groq + ElevenLabs + Baileys",
  "engines": {
    "node": ">=20.0.0 <26.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "render-build": "bash scripts/render-build.sh",
    "start": "node --max-old-space-size=256 dist/bootstrap.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.2",
    "@hapi/boom": "^9.1.3",
    "@whiskeysockets/baileys": "^6.7.9",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "groq-sdk": "^0.9.1",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.22.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
